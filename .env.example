# Which model provider handles calls that do not name one: gemini | openrouter
# (explicit choice; there is no automatic fallback between providers)
MODEL_PROVIDER="gemini"

# Direct Gemini (MODEL_PROVIDER=gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Embeddings for semantic retrieval (google/gemini-embedding-001, 768 dims):
#   gemini (default) -> Gemini API directly with GEMINI_API_KEY
#   openrouter       -> the same model through OpenRouter with OPENROUTER_API_KEY
# Explicit choice, no fallback; runs report SEMANTIC_RETRIEVAL.
EMBEDDING_PROVIDER="gemini"

# OpenRouter (MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# Exact OpenRouter model id, as listed at https://openrouter.ai/models (no default)
OPENROUTER_MODEL_ID=""
# Optional: output token ceiling per request (default 8192)
OPENROUTER_MAX_TOKENS=""
# Optional: separate model for the judge; defaults to OPENROUTER_MODEL_ID
OPENROUTER_JUDGE_MODEL_ID=""

# TypeSafe Jev judge via OpenRouter Decisions API — separate key with its own limit
OPENROUTER_JEV_API_KEY="MY_OPENROUTER_JEV_API_KEY"
# Optional: defaults to ~typesafe/jev-latest
JEV_MODEL_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
