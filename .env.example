# Which model provider handles calls that do not name one: gemini | openrouter
# (explicit choice; there is no automatic fallback between providers)
MODEL_PROVIDER="gemini"

# Direct Gemini (MODEL_PROVIDER=gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter (MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# Exact OpenRouter model id, as listed at https://openrouter.ai/models (no default)
OPENROUTER_MODEL_ID=""
# Optional: separate model for the judge; defaults to OPENROUTER_MODEL_ID
OPENROUTER_JUDGE_MODEL_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
